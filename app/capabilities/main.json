{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the vault commands of LLavero Digital, only for the main window. No core plugins (no file system, shell, HTTP, clipboard...).",
  "windows": ["main"],
  "permissions": [
    "allow-vault-status",
    "allow-create-vault",
    "allow-unlock-vault",
    "allow-lock-vault",
    "allow-list-entries",
    "allow-get-entry",
    "allow-reveal-secret",
    "allow-add-entry",
    "allow-update-entry",
    "allow-delete-entry",
    "allow-generate-password",
    "allow-check-url",
    "allow-estimate-strength",
    "allow-copy-to-clipboard"
  ]
}
